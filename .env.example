# Copied into the YAML config via ${VAR} interpolation (see config/config.example.yaml).
# Copy this file to .env and fill in real values; .env is gitignored.

POSTGRES_PASSWORD=change_me
MARZBAN_ADMIN_USERNAME=admin_vpn
MARZBAN_ADMIN_PASSWORD=change_me

# Shared secret the node-side collector sends as a Bearer token to
# POST /api/v1/ingest/events. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=change_me

# Shared secret for the admin dashboard API (/api/v1/admin/*).
ADMIN_API_KEY=change_me

# Optional — Telegram alerts on level >= 2 mitigation events.
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# Optional — generic webhook (e.g. Slack/Discord incoming webhook) for the
# same alerts.
MARZBAN_GUARD_WEBHOOK_URL=

# Path to config.yaml (defaults to config/config.yaml if unset).
MARZBAN_GUARD_CONFIG=config/config.yaml

# Grafana admin login (docker-compose.yml).
GRAFANA_ADMIN_PASSWORD=change_me
