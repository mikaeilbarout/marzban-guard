# Copy to /etc/marzban-guard/collector.env on the Xray/Marzban node.
# chmod 600 it — it contains the ingest API key.

MG_INGEST_URL=https://marzban-guard.internal.example.com
MG_INGEST_API_KEY=change_me_same_value_as_INGEST_API_KEY_in_central_service

# A short, stable name identifying THIS node (used to label every event
# and shown in the admin dashboard / Prometheus metrics).
MG_NODE_ID=node-1

# Path to Xray's access log on this node. For a standard Marzban install
# this is normally under Xray's data dir — confirm with:
#   docker exec marzban-node cat /etc/supervisord.conf   (or check xray_config.json's "log" section)
MG_XRAY_ACCESS_LOG_PATH=/var/lib/marzban-node/xray-access.log

# Where the collector remembers its read position across restarts.
MG_STATE_FILE=/var/lib/marzban-guard/collector.state

# Only set this if your Marzban version's Xray "email" tag is
# "username<SEPARATOR>something-else" rather than plain "username" — e.g.
# "." if you see lines like "email: alice.4f3a2b1c". Leave empty
# otherwise (the default, and the common case).
MG_EMAIL_STRIP_SUFFIX_AT=

MG_BATCH_SIZE=200
MG_BATCH_INTERVAL_SECONDS=2
MG_MAX_BUFFERED_EVENTS=50000
MG_LOG_LEVEL=INFO
